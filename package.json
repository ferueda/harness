{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "harness": "./dist/bin/harness.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "make check",
    "check:plan": "oxfmt --check dev/plans && vitest run test/docs-contracts.test.ts",
    "check:v": "make check-v",
    "codex:proxy": "node scripts/codex-proxy.mjs",
    "fix": "make fix",
    "fix:plan": "oxfmt --write dev/plans",
    "format": "oxfmt --write bin lib providers scripts workflows test docs skills automations AGENTS.md README.md package.json plugin.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check bin lib providers scripts workflows test docs skills automations AGENTS.md README.md package.json plugin.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint -c .oxlintrc.json bin lib providers scripts workflows test vitest.config.ts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix bin lib providers scripts workflows test vitest.config.ts",
    "package:plugin": "node scripts/package-plugin.ts",
    "prepare": "simple-git-hooks",
    "smoke:dist": "node scripts/smoke-dist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.37",
    "@openai/codex": "0.162.1",
    "@openai/codex-sdk": "0.162.1",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "{bin,lib,providers,scripts,workflows,test,docs}/**/*.{ts,js,json,md}": "pnpm exec oxfmt --write",
    "./{package.json,plugin.json,tsconfig.json,tsconfig.build.json,vitest.config.ts,.oxlintrc.json,.oxfmtrc.json}": "pnpm exec oxfmt --write",
    "{bin,lib,providers,scripts,workflows,test}/**/*.{ts,js}": "pnpm exec oxlint -c .oxlintrc.json --fix",
    "./vitest.config.ts": "pnpm exec oxlint -c .oxlintrc.json --fix",
    "{skills,automations}/**/*.md": "pnpm exec oxfmt --write",
    "./{AGENTS,README}.md": "pnpm exec oxfmt --write"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
