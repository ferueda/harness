{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "harness": "./dist/bin/harness.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "make check",
    "check:ci": "make check-ci",
    "check:plan": "oxfmt --check dev/plans && vitest run test/docs-contracts.test.ts",
    "check:v": "make check-v",
    "codex:proxy": "node scripts/codex-proxy.mjs",
    "fix": "make fix",
    "fix:plan": "oxfmt --write dev/plans",
    "format": "oxfmt --write bin lib providers scripts workflows test docs skills automations AGENTS.md README.md package.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check bin lib providers scripts workflows test docs skills automations AGENTS.md README.md package.json tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint -c .oxlintrc.json bin lib providers scripts workflows test vitest.config.ts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix bin lib providers scripts workflows test vitest.config.ts",
    "prepare": "simple-git-hooks",
    "smoke:dist": "node scripts/smoke-dist.ts",
    "smoke:linear-automation": "node scripts/smoke-linear-automation.ts",
    "smoke:linear-automation-compose": "node scripts/smoke-linear-automation-compose.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.31",
    "@ferueda/grove": "1.4.5",
    "@linear/sdk": "93.0.1",
    "@openai/codex": "0.153.4",
    "@openai/codex-sdk": "0.153.4",
    "commander": "15.0.0",
    "inngest": "4.20.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@inngest/test": "1.0.0",
    "@types/node": "24.13.3",
    "inngest-cli": "1.44.0",
    "lint-staged": "17.5.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "{bin,lib,providers,scripts,workflows,test,docs}/**/*.{ts,js,json,md}": "pnpm exec oxfmt --write",
    "./{package.json,tsconfig.json,tsconfig.build.json,vitest.config.ts,.oxlintrc.json,.oxfmtrc.json}": "pnpm exec oxfmt --write",
    "{bin,lib,providers,scripts,workflows,test}/**/*.{ts,js}": "pnpm exec oxlint -c .oxlintrc.json --fix",
    "./vitest.config.ts": "pnpm exec oxlint -c .oxlintrc.json --fix",
    "{skills,automations}/**/*.md": "pnpm exec oxfmt --write",
    "./{AGENTS,README}.md": "pnpm exec oxfmt --write"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
