{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationRevisionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "rationale", "responses", "proof", "remainingUncertainty", "questions"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["updated", "unchanged", "needs-input"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "disposition", "rationale", "evidence"],
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^implementation-review-finding-[0-9a-f]{64}$"
          },
          "disposition": {
            "type": "string",
            "enum": ["accepted", "adapted", "declined"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "path", "lineStart", "lineEnd", "summary"],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["selected-source", "code", "docs", "test", "repo-state"]
                },
                "path": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "lineStart": {
                  "type": ["integer", "null"],
                  "minimum": 1
                },
                "lineEnd": {
                  "type": ["integer", "null"],
                  "minimum": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      }
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "status", "observedResult"],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "observedResult": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "remainingUncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
