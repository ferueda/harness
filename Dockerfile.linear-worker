# syntax=docker/dockerfile:1.7

FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /build

RUN corepack enable && corepack prepare pnpm@12.3.4 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=harness-pnpm,target=/pnpm/store \
    SKIP_INSTALL_SIMPLE_GIT_HOOKS=1 pnpm install --frozen-lockfile

COPY bin ./bin
COPY lib ./lib
COPY providers ./providers
COPY schemas ./schemas
COPY workflows ./workflows
COPY tsconfig.json tsconfig.build.json ./

RUN pnpm build && pnpm prune --prod --ignore-scripts

FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS runtime

ENV CODEX_HOME=/home/node/.codex
ENV COREPACK_HOME=/opt/corepack
ENV HOME=/home/node
ENV NODE_ENV=production
ENV PATH=/app/node_modules/.bin:${PATH}
WORKDIR /app

# Git is required by Harness's workspace guard, Grove, and Codex repository discovery.
# Warm pnpm's native executable while building so the worker can run it offline.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack install --global pnpm@12.3.4 \
    && pnpm --version \
    && git config --system --add safe.directory /workspace \
    && mkdir -p \
      /home/node/.cache/pnpm \
      /home/node/.codex \
      /home/node/.harness/repositories \
    && chown -R node:node \
      /home/node/.cache \
      /home/node/.codex \
      /home/node/.harness

COPY --from=build --chown=node:node /build/package.json /build/pnpm-lock.yaml /build/pnpm-workspace.yaml ./
COPY --from=build --chown=node:node /build/node_modules ./node_modules
COPY --from=build --chown=node:node /build/dist ./dist
COPY --from=build --chown=node:node /build/schemas ./schemas

USER node
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=6 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:8080/ready').then((response)=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "dist/bin/harness.js", "linear", "worker", "--workspace", "/workspace"]
